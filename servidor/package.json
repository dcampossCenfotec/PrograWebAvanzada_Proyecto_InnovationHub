{
  "name": "innovation-hub-servidor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "lint": "eslint .",
    "fixtures:validate": "node ../pruebas/fixtures/validate-fixtures.mjs",
    "seed": "npm run fixtures:validate && node --env-file-if-exists=.env scripts/seed.js",
    "db:reset:test": "node --env-file-if-exists=.env.test scripts/reset-test-database.js",
    "test": "node --test",
    "test:integration": "node --env-file-if-exists=.env.test scripts/require-integration-env.js && node --env-file-if-exists=.env.test --test test/integration/*.test.js",
    "test:watch": "node --test --watch",
    "check": "npm run lint && npm run fixtures:validate && npm test"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "9.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
