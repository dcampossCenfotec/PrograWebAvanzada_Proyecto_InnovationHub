        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana.owner@example.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
