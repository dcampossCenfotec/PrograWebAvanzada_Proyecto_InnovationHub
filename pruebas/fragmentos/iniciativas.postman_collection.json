              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Iniciativa de prueba Postman\",\n  \"type\": \"idea\",\n  \"summary\": \"Registro reproducible para probar escritura y consulta de iniciativas.\",\n  \"description\": \"Esta iniciativa sintética verifica el contrato del módulo durante el handoff.\",\n  \"problem\": \"Verificar escritura, permisos y persistencia sin depender de las pantallas.\",\n  \"beneficiaries\": \"Equipo del proyecto\",\n  \"categoryId\": \"technology\",\n  \"skillIds\": [\n    \"aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa1\"\n  ],\n  \"estimatedMembers\": 4,\n  \"visibility\": \"public\",\n  \"tags\": [\n    \"prueba\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const created=pm.response.json().data; pm.collectionVariables.set('initiativeId',created.id);",
              "pm.test('Publicada con propietario y membresia', () => { pm.expect(created.state).to.equal('published'); pm.expect(created.memberCount).to.equal(1); pm.expect(created.availableSpaces).to.equal(3); });"
            ]
          }
        }
      ]
    },
