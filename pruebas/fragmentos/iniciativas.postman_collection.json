    {
      "id": "c936ff66-bea9-5649-8839-2f1a6258053e",
      "name": "03 Catalogo visitante",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/initiatives?page=1&size=50",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Solo publicadas accesibles al visitante', () => { const b=pm.response.json(); pm.expect(b.data).to.be.an('array'); b.data.forEach(i=>{ pm.expect(i.visibility).to.equal('public'); pm.expect(['published','forming_team','converted']).to.include(i.state); }); });",
              "pm.test('No hay campos internos o correo', () => { const text=JSON.stringify(pm.response.json()); ['_id','revision','searchText','publicSearchText','titleNormalized','email','passwordHash','tokenHash'].forEach(f=>pm.expect(text).not.to.include('\"'+f+'\"')); });"
            ]
          }
        }
      ]
    },
